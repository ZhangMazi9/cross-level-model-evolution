                raw_y = table[17, 2] + (table[18, 2] - table[17, 2]) * (x - 4.064) / (4.318 - 4.064);
            elseif x <= 4.572 then
                raw_y = table[18, 2] + (table[19, 2] - table[18, 2]) * (x - 4.318) / (4.572 - 4.318);
            elseif x <= 4.826 then
                raw_y = table[19, 2] + (table[20, 2] - table[19, 2]) * (x - 4.572) / (4.826 - 4.572);
            elseif x <= 5.08 then
                raw_y = table[20, 2] + (table[21, 2] - table[20, 2]) * (x - 4.826) / (5.08 - 4.826);
            elseif x <= 5.334 then
                raw_y = table[21, 2] + (table[22, 2] - table[21, 2]) * (x - 5.08) / (5.334 - 5.08);
            elseif x <= 5.588 then
                raw_y = table[22, 2] + (table[23, 2] - table[22, 2]) * (x - 5.334) / (5.588 - 5.334);
            elseif x <= 5.842 then
                raw_y = table[23, 2] + (table[24, 2] - table[23, 2]) * (x - 5.588) / (5.842 - 5.588);
            elseif x <= 6.096 then
                raw_y = table[24, 2] + (table[25, 2] - table[24, 2]) * (x - 5.842) / (6.096 - 5.842);
            elseif x <= 6.35 then
                raw_y = table[25, 2] + (table[26, 2] - table[25, 2]) * (x - 6.096) / (6.35 - 6.096);
            elseif x <= 6.604 then
                raw_y = table[26, 2] + (table[27, 2] - table[26, 2]) * (x - 6.35) / (6.604 - 6.35);
            elseif x <= 6.858 then
                raw_y = table[27, 2] + (table[28, 2] - table[27, 2]) * (x - 6.604) / (6.858 - 6.604);
            elseif x <= 7.112 then
                raw_y = table[28, 2] + (table[29, 2] - table[28, 2]) * (x - 6.858) / (7.112 - 6.858);
            elseif x <= 7.366 then
                raw_y = table[29, 2] + (table[30, 2] - table[29, 2]) * (x - 7.112) / (7.366 - 7.112);
            elseif x <= 7.62 then
                raw_y = table[30, 2] + (table[31, 2] - table[30, 2]) * (x - 7.366) / (7.62 - 7.366);
            elseif x <= 7.874 then
                raw_y = table[31, 2] + (table[32, 2] - table[31, 2]) * (x - 7.62) / (7.874 - 7.62);
            elseif x <= 8.128 then
                raw_y = table[32, 2] + (table[33, 2] - table[32, 2]) * (x - 7.874) / (8.128 - 7.874);
            elseif x <= 8.382 then
                raw_y = table[33, 2] + (table[34, 2] - table[33, 2]) * (x - 8.128) / (8.382 - 8.128);
            elseif x <= 8.636 then
                raw_y = table[34, 2] + (table[35, 2] - table[34, 2]) * (x - 8.382) / (8.636 - 8.382);
            elseif x <= 8.89 then
                raw_y = table[35, 2] + (table[36, 2] - table[35, 2]) * (x - 8.636) / (8.89 - 8.636);
            elseif x <= 9.144 then
                raw_y = table[36, 2] + (table[37, 2] - table[36, 2]) * (x - 8.89) / (9.144 - 8.89);
            elseif x <= 9.398 then
                raw_y = table[37, 2] + (table[38, 2] - table[37, 2]) * (x - 9.144) / (9.398 - 9.144);
            elseif x <= 9.652 then
                raw_y = table[38, 2] + (table[39, 2] - table[38, 2]) * (x - 9.398) / (9.652 - 9.398);
            elseif x <= 9.906 then
                raw_y = table[39, 2] + (table[40, 2] - table[39, 2]) * (x - 9.652) / (9.906 - 9.652);
            elseif x <= 10.16 then
                raw_y = table[40, 2] + (table[41, 2] - table[40, 2]) * (x - 9.906) / (10.16 - 9.906);
            elseif x <= 10.414 then
                raw_y = table[41, 2] + (table[42, 2] - table[41, 2]) * (x - 10.16) / (10.414 - 10.16);
            elseif x <= 10.668 then
                raw_y = table[42, 2] + (table[43, 2] - table[42, 2]) * (x - 10.414) / (10.668 - 10.414);
            elseif x <= 10.922 then
                raw_y = table[43, 2] + (table[44, 2] - table[43, 2]) * (x - 10.668) / (10.922 - 10.668);
            elseif x <= 11.176 then
                raw_y = table[44, 2] + (table[45, 2] - table[44, 2]) * (x - 10.922) / (11.176 - 10.922);
            elseif x <= 11.43 then
                raw_y = table[45, 2] + (table[46, 2] - table[45, 2]) * (x - 11.176) / (11.43 - 11.176);
            elseif x <= 11.684 then
                raw_y = table[46, 2] + (table[47, 2] - table[46, 2]) * (x - 11.43) / (11.684 - 11.43);
            elseif x <= 11.938 then
                raw_y = table[47, 2] + (table[48, 2] - table[47, 2]) * (x - 11.684) / (11.938 - 11.684);
            elseif x <= 12.192 then
                raw_y = table[48, 2] + (table[49, 2] - table[48, 2]) * (x - 11.938) / (12.192 - 11.938);
            elseif x <= 12.446 then
                raw_y = table[49, 2] + (table[50, 2] - table[49, 2]) * (x - 12.192) / (12.446 - 12.192);
            elseif x <= 12.7 then
                raw_y = table[50, 2] + (table[51, 2] - table[50, 2]) * (x - 12.446) / (12.7 - 12.446);
            else
                raw_y = table[51, 2];
            end;
            y = raw_y - table[1, 2];
    end;

    continuous DropTestGroundBlock
        port:
            output real ground_height;
        equation:
            ground_height = 0.0;
    end;

    continuous MainGearTireWheelAssembly
        parameter:
            real tire_radius = 0.4318;
            real tire_stiffness = 1700000.0;
        value:
            real raw_deflection;
        port:
            input real ground_height;
            input real y_u;
            output real tire_deflection;
            output real tire_force;
        equation:
            raw_deflection = ground_height + tire_radius - y_u;
            if raw_deflection > 0.0 then
                tire_deflection = raw_deflection;
            else
                tire_deflection = 0.0;
            end;
            tire_force = tire_stiffness * tire_deflection;
    end;

    continuous ShockStrutSlidingJoint
        parameter:
            real oleo_initial_axial_length = 0.30;
            real oleo_axis_vertical_projection = 1.0;
            real max_air_chamber_compression = 0.0189;
            real max_piston_stroke = 0.20;
            real smooth_epsilon = 1.0e-12;
        value:
            real oleo_raw_compression;
            real oleo_nonnegative_compression;
            real oleo_raw_compression_speed;
            real air_deflection_candidate;
        port:
            input real y_s;
            input real y_u;
            input real v_s;
            input real v_u;
            output real oleo_compression;
            output real oleo_compression_speed;
            output real air_deflection;
            output real oleo_axial_length;
        equation:
            oleo_raw_compression = oleo_initial_axial_length - (y_s - y_u) / oleo_axis_vertical_projection;
            oleo_nonnegative_compression = 0.5 * (oleo_raw_compression + sqrt(oleo_raw_compression * oleo_raw_compression + smooth_epsilon));
            oleo_compression = 0.5 * (oleo_initial_axial_length + oleo_nonnegative_compression - sqrt((oleo_initial_axial_length - oleo_nonnegative_compression) * (oleo_initial_axial_length - oleo_nonnegative_compression) + smooth_epsilon));
            oleo_axial_length = oleo_initial_axial_length - oleo_compression;

            oleo_raw_compression_speed = (v_u - v_s) / oleo_axis_vertical_projection;
            oleo_compression_speed = 0.5 * (oleo_raw_compression_speed + sqrt(oleo_raw_compression_speed * oleo_raw_compression_speed + smooth_epsilon));

            air_deflection_candidate = max_air_chamber_compression / max_piston_stroke * oleo_compression;
            air_deflection = 0.5 * (max_air_chamber_compression + air_deflection_candidate - sqrt((max_air_chamber_compression - air_deflection_candidate) * (max_air_chamber_compression - air_deflection_candidate) + smooth_epsilon));
    end;

    continuous HydraulicDampingChannel
        parameter:
            real linear_damping_coeff = 153475.1727204978;
            real quadratic_damping_gain = 1.9602485837391784;
        port:
            input real oleo_compression_speed;
            output real damping_force;
        equation:
            damping_force = linear_damping_coeff * oleo_compression_speed + quadratic_damping_gain * oleo_compression_speed * oleo_compression_speed;
    end;

    continuous OleoPneumaticShockStrutAssembly
        port:
            input real air_force;
            input real oil_force;
            input real damping_force;
            output real oleo_force;
        equation:
            oleo_force = air_force + oil_force + damping_force;
    end;

    continuous DropTestReleaseFixture
        parameter:
            real release_force_0 = 8755.15;
            real release_tau = 0.005;
        value:
            real release_clock;
        port:
            output real release_force;
        initial equation:
            release_clock = 0.0;
        equation:
            der(release_clock) = 1.0;
            release_force = release_force_0 * exp(-release_clock / release_tau);
    end;

    continuous EquivalentAirframeWheelMassAssembly
        parameter:
            real g = 9.81;
            real sprung_mass = 6925.5;
            real wheel_mass = 300.0;
            real tire_radius = 0.4318;
            real initial_ground_clearance = 0.21056;
            real oleo_initial_axial_length = 0.30;
            real oleo_axis_vertical_projection = 1.0;
            real release_initial_velocity = 0.0;
        value:
            real y_s;
            real v_s;
            real y_u;
            real v_u;
            real a_s;
            real a_u;
        port:
            input real tire_force;
            input real oleo_force;
            input real release_force;
            output real y_s_out;
            output real v_s_out;
            output real a_s_out;
            output real y_u_out;
            output real v_u_out;
            output real a_u_out;
        initial equation:
            y_u = tire_radius + initial_ground_clearance;
            y_s = tire_radius + initial_ground_clearance + oleo_initial_axial_length * oleo_axis_vertical_projection;
            v_s = 0.0;
            v_u = release_initial_velocity;
        equation:
            a_s = -g + oleo_force / sprung_mass;
            a_u = -g - oleo_force / wheel_mass + tire_force / wheel_mass + release_force / wheel_mass;
            der(y_s) = v_s;
            der(v_s) = a_s;
            der(y_u) = v_u;
            der(v_u) = a_u;
            y_s_out = y_s;
            v_s_out = v_s;
            a_s_out = a_s;
            y_u_out = y_u;
            v_u_out = v_u;
            a_u_out = a_u;
    end;

    continuous OleoPistonRod
        parameter:
            real piston_accel_sprung_weight = 0.02;
        value:
            real physical_piston_zdd;
        port:
            input real a_s;
            input real a_u;
            output real piston_zdd_out;
        equation:
            physical_piston_zdd = piston_accel_sprung_weight * a_s + (1.0 - piston_accel_sprung_weight) * a_u;
            piston_zdd_out = physical_piston_zdd;
    end;

    couple LandingGearSystem
        part:
            DropTestGroundBlock groundBlock;
            MainGearTireWheelAssembly tireWheel;
            ShockStrutSlidingJoint strutSlidingJoint;
            ShockStrutGasChamber gasChamber;
            ShockStrutOilChamber oilChamber;
            HydraulicDampingChannel dampingChannel;
            OleoPneumaticShockStrutAssembly shockStrut;
            DropTestReleaseFixture releaseFixture;
            EquivalentAirframeWheelMassAssembly equivalentMasses;
            OleoPistonRod pistonRod;
        connection:
            connect(groundBlock.ground_height, tireWheel.ground_height);
            connect(equivalentMasses.y_u_out, tireWheel.y_u);
            connect(tireWheel.tire_force, equivalentMasses.tire_force);

            connect(equivalentMasses.y_s_out, strutSlidingJoint.y_s);
            connect(equivalentMasses.y_u_out, strutSlidingJoint.y_u);
            connect(equivalentMasses.v_s_out, strutSlidingJoint.v_s);
            connect(equivalentMasses.v_u_out, strutSlidingJoint.v_u);
            connect(strutSlidingJoint.air_deflection, gasChamber.x);
            connect(gasChamber.y, shockStrut.air_force);
            connect(strutSlidingJoint.oleo_compression, oilChamber.x);
            connect(oilChamber.y, shockStrut.oil_force);
            connect(strutSlidingJoint.oleo_compression_speed, dampingChannel.oleo_compression_speed);
            connect(dampingChannel.damping_force, shockStrut.damping_force);
            connect(shockStrut.oleo_force, equivalentMasses.oleo_force);

            connect(releaseFixture.release_force, equivalentMasses.release_force);
            connect(equivalentMasses.a_s_out, pistonRod.a_s);
            connect(equivalentMasses.a_u_out, pistonRod.a_u);
    end;

    pruning:
        instance sys of LandingGearSystem {}
    end;
end;

simulation of LandingGearReduced {
    run instance sys;
    solver StopTime = 5.0;
}

