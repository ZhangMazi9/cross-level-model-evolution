          "name": "PHYS_EVT_DESCENT_START",
          "description": "Descent start event marker"
        },
        {
          "direction": "input",
          "data_type": "real",
          "name": "PHYS_EVT_TOUCHDOWN",
          "description": "Touchdown event marker"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_y_s",
          "description": "Measured airframe displacement"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_y_u",
          "description": "Measured wheel displacement"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_v_s",
          "description": "Measured airframe velocity"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_v_u",
          "description": "Measured wheel velocity"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_piston_zdd_out",
          "description": "Measured airframe acceleration"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_tire_deflection",
          "description": "Measured tire compression"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_oleo_compression",
          "description": "Measured strut stroke"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "measured_damping_force",
          "description": "Measured damping force"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "out_PHYS_EVT_DESCENT_START",
          "description": "Output descent start marker"
        },
        {
          "direction": "output",
          "data_type": "real",
          "name": "out_PHYS_EVT_TOUCHDOWN",
          "description": "Output touchdown marker"
        }
      ],
      "initial_equations": [],
      "equations": [],
      "actions": [
        "measured_y_s = y_s",
        "measured_y_u = y_u",
        "measured_v_s = v_s",
        "measured_v_u = v_u",
        "measured_piston_zdd_out = piston_zdd_out",
        "measured_tire_deflection = tire_deflection",
        "measured_oleo_compression = oleo_compression",
        "measured_damping_force = damping_force",
        "out_PHYS_EVT_DESCENT_START = PHYS_EVT_DESCENT_START",
        "out_PHYS_EVT_TOUCHDOWN = PHYS_EVT_TOUCHDOWN"
      ]
    }
  ],
